# 强制脚本与文本文件以 LF 行尾检出，防止 Windows CRLF 导致 shell 脚本在 Linux 服务器报错
*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.tar.gz binary
