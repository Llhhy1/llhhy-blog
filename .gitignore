# 部署产物
*.zip
sha256.txt
# v3.18.7：发布物签名（package.py 的产物，随 Release 上传，不入库）
sha256.txt.sig

# 数据库与运行时数据
data/
*.db
*.db-journal

# Python
__pycache__/
*.pyc
venv/
.env
# Flask 实例目录（本地运行时的运行时数据，自动生成，不入版本库）
instance/

# Node
node_modules/
dist/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store

# 临时构建目录（用非 dist 名规避本地删除保护，等同 dist/）
# 说明：历史上每升一个新 _vite_buildN 就得手加一行，改为通配符一次覆盖所有历史与未来构建。
_vite_build*/
dist_v3*/

# 项目本地数据目录（本地数据，不入版本库）：memory/ 项目记忆、tools/ 助手脚本、blog_venv/ 测试环境
# 说明：仓库已于 2026-09-20 迁至 E:\WR\llhhy-blog，工作区数据统一收进本目录。
.workbuddy/

# 本地资料（手记 / 评审报告 / 落地方案，放仓库根但不入版本库）
UI与运营升级清单.md
llhhy-blog-评审报告.md
综合落地方案-llhhy-blog.md

# 临时 CRLF 修复包（不入库）
deploy_scripts_crlf_fix.zip

# API 路由快照产物（tools/api_routes_snapshot.py 的输出，可随时重跑，不入库）
tools/_api_routes_*.txt
.venv-audit/

# 插件运行时禁用标记（手动关停某插件用，勿提交；见 PLUGIN_SYSTEM.md M3）
myblog/plugins/*/disabled

# v3.17.12（审计 R77）：纪律零「临时产物零入版」黑名单——此前仅靠 pre-commit/pre-push 钩子拦截，
# 这里在 gitignore 层再兜一层，避免 `git add -A` 误把一次性脚本加进暂存区。
_verify_*.py
_make_release_*.py
smoke_*.py
# 本地审查/排查脚本（一次性，不入库）
_review_*.py
_rescan*.py

# 覆盖率产物（v3.20.0 起 CI 跑 coverage；`.coverage` 是二进制数据文件，绝不入库）
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/

# playwright-cli 的临时快照/日志（走查用，绝不入版）
# 教训：v4.12.1 提交时 `git add -A` 把它一起带进去了，靠 .gitignore 兜住。
.playwright-cli/

# 京华老宋体的 cn-font-split 分片产物（503 个 woff2 + 一份生成的 CSS，约 26MB）。
# 由 tools/fetch_kinghua_font.py 在部署机上跑一次生成；不进 git 有两个理由：
# 二进制资产不该让代码仓库长期背着，且这份 CSS 是**上游产物**，改它只能重跑脚本
# （手工编辑会在下次重跑时被无声覆盖）。
myblog/static/fonts/kinghua/
myblog/static/fonts/kinghua.css

# v5.9.0 子集字体的源 OTF（11.6 MB）：构建时由 tools/build_subset_font.py
# 自动下载到此处，只作一次性输入，产物 woff2 才入版。
tools/.font-source/
